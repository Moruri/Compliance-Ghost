# --- Compliance Ghost server config ---

# Port the Express server listens on
PORT=4000

# Origin allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- IBM Bob configuration ---
# The HTTP endpoint that accepts { files, regulations, instructions } and
# returns the structured JSON described in server/src/lib/prompt.js.
# Leave blank to fall back to mock mode (useful for offline demos).
BOB_API_URL=
BOB_API_KEY=

# When true, the BobClient short-circuits to deterministic scripted data
# regardless of BOB_API_URL. Set this for the bundled demo.
BOB_MOCK=true

# --- Repo scanning limits ---
# Maximum number of source files sent to Bob per scan
MAX_FILES=400
# Maximum total bytes of source code sent to Bob per scan
MAX_BYTES=2000000
